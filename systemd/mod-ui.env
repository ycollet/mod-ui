# mod-ui environment overrides
# Uncomment and edit the lines you want to change.
# This file is loaded by the systemd service unit (optional).

# Web server port (default: 8888)
#MOD_DEVICE_WEBSERVER_PORT=8888

# User data directory (default: ~/.local/share/mod-ui)
#MOD_DATA_DIR=/var/lib/mod-ui

# Use a stub host instead of connecting to mod-host (0 or 1).
# Set to 1 if mod-host is not installed or JACK is not running.
# When mod-host.service is active this should be 0 (the default).
#MOD_DEV_HOST=1

# Force dev environment (no hardware HMI) (0 or 1)
#MOD_DEV_ENVIRONMENT=1

# Enable verbose logging (0 or 1)
#MOD_LOG=1

# Override HTML location
#MOD_HTML_DIR=/usr/share/mod/html

# Override default pedalboard location
#MOD_DEFAULT_PEDALBOARD=/usr/share/mod/default.pedalboard
