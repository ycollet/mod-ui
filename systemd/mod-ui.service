[Unit]
Description=MOD Audio UI Web Server
Documentation=https://github.com/moddevices/mod-ui
After=network.target sound.target
Wants=sound.target

[Service]
Type=simple
# Load site-specific overrides (PORT, DATA_DIR, DEV_HOST flag, …)
EnvironmentFile=-@SYSCONFDIR@/mod-ui/mod-ui.env
# Resolved at package install time by the Makefile
Environment=MOD_HTML_DIR=@DATADIR@/mod/html
Environment=MOD_DEFAULT_PEDALBOARD=@DATADIR@/mod/default.pedalboard
Environment=MOD_DATA_DIR=%h/.local/share/mod-ui
Environment=MOD_DEV_ENVIRONMENT=1
Environment=MOD_LOG=1
Environment=MOD_DEVICE_WEBSERVER_PORT=8888
ExecStart=@BINDIR@/mod-ui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
